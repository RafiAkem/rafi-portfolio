# Salin ke .env.local lalu isi.
# Dapatkan API key gratis di https://resend.com/api-keys

# Wajib: dipakai API route /api/contact untuk mengirim pesan.
RESEND_API_KEY=

# Opsional: penerima pesan kontak. Default: yc66zio@gmail.com
# CONTACT_TO=

